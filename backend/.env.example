# =============================================================================
# Chen筱雪 Reborn - 环境变量配置
# 复制本文件为 .env 并填入你的 API Keys
# =============================================================================

# --- 运行环境 ---
# development: 开发模式（DEBUG=True, CORS 宽松）
# production:  生产模式（DEBUG=False, CORS 严格, 强制 HTTPS 头）
ENV=development
DEBUG=true

# --- DeepSeek (必填) ---
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- OpenAI (可选) ---
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com

# --- 通义千问 (阿里云，可选) ---
# 获取地址: https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 豆包/火山引擎 (可选) ---
# 获取地址: https://console.volcengine.com/ark
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- 月之暗面 Kimi (可选) ---
# 获取地址: https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn

# --- Claude/Anthropic (可选) ---
# 获取地址: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-your-claude-api-key

# --- 数据库 ---
DATABASE_URL=sqlite+aiosqlite:///./data/chenxiaoxue.db

# --- 安全 (必填) ---
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ 生产环境必须使用强随机密钥，长度 >= 32 字符
SECRET_KEY=your-secret-key-change-in-production

# --- 服务器 ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- CORS (可选) ---
# 额外的允许来源，逗号分隔。生产环境需配置前端域名
CORS_ORIGINS=
